# Environment
KEPLER_ENV=local
KEPLER_LOG_LEVEL=INFO

# Data source: s3 | local_csv | nasa_archive
KEPLER_DATA_SOURCE=local_csv
KEPLER_LOCAL_CSV_PATH=data/samples/kepler_koi_sample.csv
KEPLER_S3_BUCKET=kepler-koi-data
KEPLER_S3_KEY=cumulative.csv
KEPLER_NASA_TAP_URL=https://exoplanetarchive.ipac.caltech.edu/TAP/sync?query=select+*+from+cumulative&format=csv

# AWS (omit on EKS — use IRSA instead)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
# AWS_ENDPOINT_URL is only for S3-compatible stores used by the app's ingestion layer
# KEPLER_S3_ENDPOINT_URL=http://localhost:9000

# Redis
KEPLER_REDIS_URL=redis://localhost:6379/0
# Keep the readiness probe inside its timeout when Redis is unreachable
KEPLER_REDIS_CONNECT_TIMEOUT_SECONDS=1.0
KEPLER_REDIS_SOCKET_TIMEOUT_SECONDS=2.0

# MLflow
MLFLOW_TRACKING_URI=http://localhost:5000
KEPLER_MLFLOW_EXPERIMENT_NAME=kepler-koi
KEPLER_REGISTERED_MODEL_NAME=kepler-koi-classifier
KEPLER_MODEL_ALIAS=champion
KEPLER_MODEL_CACHE_TTL_SECONDS=60
# Bound MLflow's HTTP retries; its default (7, exponential) stalls startup and the
# readiness probe for minutes when the tracking server is unreachable.
KEPLER_MLFLOW_HTTP_MAX_RETRIES=1
KEPLER_MLFLOW_HTTP_TIMEOUT_SECONDS=5
# Must be a whole number: MLflow parses this variable with int(), so a fractional
# value makes every tracking-server request fail before it is sent.
KEPLER_MLFLOW_HTTP_BACKOFF_FACTOR=0

# Training / promotion
KEPLER_PROMOTE_METRIC=f1
KEPLER_PROMOTE_THRESHOLD=0.70
KEPLER_DEFAULT_TEST_SIZE=0.2
KEPLER_DEFAULT_CV_FOLDS=5
KEPLER_RANDOM_STATE=42

# Job store
KEPLER_JOB_TTL_SECONDS=86400

# API
KEPLER_API_HOST=0.0.0.0
KEPLER_API_PORT=8000

# Celery worker Prometheus scrape port (0 disables)
KEPLER_WORKER_METRICS_PORT=9100

# Docker Compose host port mappings. Only the host side of each mapping; services
# still reach each other on their in-network ports (mlflow:5000, redis:6379, ...).
# Override any that collide with something already running locally — port 5000 in
# particular is often taken by a local Docker registry or, on macOS, AirPlay.
KEPLER_API_HOST_PORT=8000
KEPLER_MLFLOW_HOST_PORT=5000
KEPLER_REDIS_HOST_PORT=6379
KEPLER_POSTGRES_HOST_PORT=5432
KEPLER_MINIO_HOST_PORT=9000
KEPLER_MINIO_CONSOLE_HOST_PORT=9001
KEPLER_WORKER_METRICS_HOST_PORT=9100
KEPLER_PROMETHEUS_HOST_PORT=9090
KEPLER_GRAFANA_HOST_PORT=3000
