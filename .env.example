# Environment
KEPLER_ENV=local
KEPLER_LOG_LEVEL=INFO

# Data source: s3 | local_csv | nasa_archive
KEPLER_DATA_SOURCE=local_csv
KEPLER_LOCAL_CSV_PATH=data/samples/kepler_koi_sample.csv
KEPLER_S3_BUCKET=kepler-koi-data
KEPLER_S3_KEY=cumulative.csv
KEPLER_NASA_TAP_URL=https://exoplanetarchive.ipac.caltech.edu/TAP/sync?query=select+*+from+cumulative&format=csv

# AWS (omit on EKS — use IRSA instead)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
# AWS_ENDPOINT_URL is only for S3-compatible stores used by the app's ingestion layer
# KEPLER_S3_ENDPOINT_URL=http://localhost:9000

# Redis
KEPLER_REDIS_URL=redis://localhost:6379/0

# MLflow
MLFLOW_TRACKING_URI=http://localhost:5000
KEPLER_MLFLOW_EXPERIMENT_NAME=kepler-koi
KEPLER_REGISTERED_MODEL_NAME=kepler-koi-classifier
KEPLER_MODEL_ALIAS=champion
KEPLER_MODEL_CACHE_TTL_SECONDS=60

# Training / promotion
KEPLER_PROMOTE_METRIC=f1
KEPLER_PROMOTE_THRESHOLD=0.70
KEPLER_DEFAULT_TEST_SIZE=0.2
KEPLER_DEFAULT_CV_FOLDS=5
KEPLER_RANDOM_STATE=42

# Job store
KEPLER_JOB_TTL_SECONDS=86400

# API
KEPLER_API_HOST=0.0.0.0
KEPLER_API_PORT=8000
